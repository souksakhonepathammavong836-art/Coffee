-- [NEW] No Cooldown Logic
local noCDActive = false
NoCDBtn.MouseButton1Click:Connect(function()
    noCDActive = not noCDActive
    if noCDActive then
        NoCDBtn.Text = "⚡ No Cooldown / Skill: ON"
        NoCDBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        NoCDBtn.Text = "⚡ No Cooldown / Skill: OFF"
        NoCDBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if noCDActive then
            pcall(function()
                local function cleanCooldowns(container)
                    if not container then return end
                    for _, item in ipairs(container:GetChildren()) do
                        if item:IsA("Tool") or item:IsA("Folder") or item:IsA("Model") then
                            for _, v in ipairs(item:GetDescendants()) do
                                if v:IsA("NumberValue") or v:IsA("IntValue") then
                                    local name = v.Name:lower()
                                    if name:find("cooldown") or name:find("cd") or name:find("delay") or name:find("reload") or name:find("wait") then
                                        v.Value = 0
                                    end
                                end
                            end
                        end
                    end
                end
                
                if LP.Character then cleanCooldowns(LP.Character) end
                if LP:FindFirstChild("Backpack") then cleanCooldowns(LP.Backpack) end
            end)
        end
    end
end)

