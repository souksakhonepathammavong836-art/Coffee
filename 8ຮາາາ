local Players = game:GetService("Players")

local ADMINS = {
	[12345678] = true, -- ປ່ຽນເປັນ UserId ຂອງເຈົ້າ
}

local function getParts(plr)
	local c = plr.Character
	return c, c and c:FindFirstChildOfClass("Humanoid"), c and c:FindFirstChild("HumanoidRootPart")
end

local commands = {
	god = function(plr, hum)
		hum.MaxHealth = math.huge
		hum.Health = math.huge
	end,
	heal = function(plr, hum)
		hum.Health = hum.MaxHealth
	end,
	speed = function(plr, hum, root, arg)
		hum.WalkSpeed = tonumber(arg) or 100
	end,
	jump = function(plr, hum, root, arg)
		hum.UseJumpPower = true
		hum.JumpPower = tonumber(arg) or 150
	end,
	coffee = function(plr, hum, root, arg)
		local c = plr:FindFirstChild("leaderstats") and plr.leaderstats:FindFirstChild("Coffee")
		if c then c.Value += tonumber(arg) or 1000 end
	end,
	big = function(plr, hum)
		for _, n in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}) do
			local v = hum:FindFirstChild(n)
			if v then v.Value = 3 end
		end
	end,
	small = function(plr, hum)
		for _, n in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}) do
			local v = hum:FindFirstChild(n)
			if v then v.Value = 0.5 end
		end
	end,
	fire = function(plr, hum, root)
		local f = Instance.new("Fire")
		f.Size = 10
		f.Parent = root
	end,
	invis = function(plr, hum, root, arg, char)
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") or p:IsA("Decal") then
				if p.Name ~= "HumanoidRootPart" then p.Transparency = 1 end
			end
		end
	end,
	sword = function(plr)
		local tool = Instance.new("Tool")
		tool.Name = "OP Sword"
		local h = Instance.new("Part")
		h.Name = "Handle"
		h.Size = Vector3.new(1, 0.4, 6)
		h.Material = Enum.Material.Neon
		h.Color = Color3.fromRGB(255, 80, 0)
		h.Parent = tool
		local swing = false
		tool.Activated:Connect(function()
			swing = true
			task.delay(0.4, function() swing = false end)
		end)
		h.Touched:Connect(function(o)
			local th = o.Parent:FindFirstChildOfClass("Humanoid")
			if swing and th and o.Parent ~= tool.Parent then
				th.Health = 0
			end
		end)
		tool.Parent = plr.Backpack
	end,
	nuke = function(plr, hum, root)
		for _, o in ipairs(Players:GetPlayers()) do
			local c, h, r = getParts(o)
			if o ~= plr and h and r and (r.Position - root.Position).Magnitude < 60 then
				h.Health = 0
			end
		end
		local e = Instance.new("Explosion")
		e.Position = root.Position
		e.BlastRadius = 30
		e.BlastPressure = 0
		e.Parent = workspace
	end,
	tp = function(plr, hum, root, arg)
		for _, o in ipairs(Players:GetPlayers()) do
			if arg and o.Name:lower():sub(1, #arg) == arg:lower() then
				local _, _, r = getParts(o)
				if r then root.CFrame = r.CFrame * CFrame.new(0, 0, 4) end
				return
			end
		end
	end,
	kill = function(plr, hum, root, arg)
		for _, o in ipairs(Players:GetPlayers()) do
			if arg and o.Name:lower():sub(1, #arg) == arg:lower() then
				local _, h = getParts(o)
				if h then h.Health = 0 end
				return
			end
		end
	end,
}

Players.PlayerAdded:Connect(function(plr)
	if not ADMINS[plr.UserId] then return end
	plr.Chatted:Connect(function(msg)
		local cmd, arg = msg:match("^[/!:](%w+)%s*(.*)$")
		local fn = cmd and commands[cmd:lower()]
		if not fn then return end
		local char, hum, root = getParts(plr)
		if char and hum and root then
			fn(plr, hum, root, arg ~= "" and arg or nil, char)
		end
	end)
end)
