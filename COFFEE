-- [[ GREEDY GROWERS - PURE SEED AUTO BUYER (NO GUI, NO POPUPS) ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

-- ປິດສະຄິບເກົ່າຖ້າມີ
pcall(function()
    if LP.PlayerGui:FindFirstChild("PureSeedHub") then
        LP.PlayerGui.PureSeedHub:Destroy()
    end
end)

-- ສ້າງ ScreenGui ປຸ່ມກົດແບບຮຽບງ່າຍ (ບໍ່ບັງໜ້າຈໍ)
local SG = Instance.new("ScreenGui")
SG.Name = "PureSeedHub"
SG.Parent = LP:WaitForChild("PlayerGui")
SG.ResetOnSpawn = false

local Btn = Instance.new("TextButton", SG)
Btn.Size = UDim2.new(0, 150, 0, 40)
Btn.Position = UDim2.new(0.5, -75, 0.1, 0)
Btn.Text = "Auto Seeds: OFF"
Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.TextSize, Btn.Font = 14, Enum.Font.SourceSansBold
Btn.Active = true
Btn.Draggable = true
Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

local autoActive = false
Btn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    if autoActive then
        Btn.Text = "Auto Seeds: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        Btn.Text = "Auto Seeds: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- ລະບົບຊື້ສະເພາະເມັດພັນ ຕັດປຸ່ມປຸ໋ຍ ແລະ ປຸ່ມໄລຟ์ອອກຢ່າງເດັດຂາດ
task.spawn(function()
    while task.wait(0.1) do
        if autoActive then
            pcall(function()
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        local fullName = v:GetFullName():lower()
                        
                        -- ຕັດທັງໜ້າຕ່າງປຸ໋ຍ (Fertilizer/Poy) ແລະ ໜ້າຕ່າງໄລຟ์ (Like/Reward/Claim/Shop) ອອກທັງໝົດ
                        if not fullName:find("like") and not fullName:find("reward") and not fullName:find("claim") and not fullName:find("shop") and not fullName:find("fertilizer") and not fullName:find("poy") then
                            local part = v.Parent
                            if part and part:IsA("BasePart") then
                                v.MaxActivationDistance = 999999
                                v.RequiresLineOfSight = false
                                fireproximityprompt(v)
                            end
                        end
                    end
                end
            end)
        end
    end
end)
