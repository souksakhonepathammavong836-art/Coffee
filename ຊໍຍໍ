-- Logic: Auto Punch
local autoPunchActive = false
AutoPunchBtn.MouseButton1Click:Connect(function()
    autoPunchActive = not autoPunchActive
    if autoPunchActive then
        AutoPunchBtn.Text = "🥊 Auto Punch / Click: ON"
        AutoPunchBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        AutoPunchBtn.Text = "🥊 Auto Punch / Click: OFF"
        AutoPunchBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end
end)

task.spawn(function()
    while true do
        local delayTime = tonumber(SpeedBox.Text) or 0.01
        task.wait(delayTime)
        
        if autoPunchActive and LP.Character then
            pcall(function()
                local tool = LP.Character:FindFirstChildOfClass("Tool") or LP.Backpack:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                end
                for _, remote in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                    if remote:IsA("RemoteEvent") and (remote.Name:lower():find("punch") or remote.Name:lower():find("click") or remote.Name:lower():find("train")) then
                        remote:FireServer()
                    end
                end
            end)
        end
    end
end)

