                if obj:IsA("BasePart") and (obj.Name:find("Chest") or obj.Name:find("Coin") or obj.Name:find("Gem") or obj.Name:find("Drop")) then
                    obj.CFrame = CFrame.new(myPos + Vector3.new(0, 2, 0))
                end
            end
        end
    end)
end)

