-- Logic: Ultra Auto Farm
local autoFarmActive = false
AutoFarmBtn.MouseButton1Click:Connect(function()
    autoFarmActive = not autoFarmActive
    if autoFarmActive then
        AutoFarmBtn.Text = "⚡ Ultra Auto Farm: ON"
        AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        AutoFarmBtn.Text = "⚡ Ultra Auto Farm: OFF"
        AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end
end)

task.spawn(function()
    while true do
        local delayTime = tonumber(SpeedBox.Text) or 0.01
        task.wait(delayTime)
        
        if autoFarmActive and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local myPos = LP.Character.HumanoidRootPart.Position
                local maxRange = tonumber(RangeBox.Text) or 100
                
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and (obj.Name:find("Block") or obj.Name:find("Part") or obj.Name:find("Wood") or obj.Name:find("Log")) then
                        if (obj.Position - myPos).Magnitude <= maxRange then
                            local tool = LP.Character:FindFirstChildOfClass("Tool") or LP.Backpack:FindFirstChildOfClass("Tool")
                            if tool then
                                for _, remote in ipairs(tool:GetDescendants()) do
                                    if remote:IsA("RemoteEvent") then
                                        remote:FireServer(obj)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

