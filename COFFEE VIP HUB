local cam = workspace.CurrentCamera
local rs = game:GetService("RunService")
local MAX_DISTANCE = 85

rs.RenderStepped:Connect(function()
    if aimbotActive and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local closestTarget = nil
            local shortestDist = math.huge
            local myPos = LP.Character.HumanoidRootPart.Position
            
            for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
                if player ~= LP and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") then
                    local hum = player.Character.Humanoid
                    local head = player.Character.Head
                    if hum.Health > 0 then
                        local distToMe = (head.Position - myPos).Magnitude
                        if distToMe <= MAX_DISTANCE then
                            local screenPoint, onScreen = cam:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local mousePos = UIS:GetMouseLocation()
                                local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    closestTarget = head
                                end
                            end
                        end
                    end
                end
            end
            
            if closestTarget then
                local targetCFrame = CFrame.new(cam.CFrame.Position, closestTarget.Position)
                cam.CFrame = cam.CFrame:Lerp(targetCFrame, 0.25)
            end
        end)
    end
end)

-- ESP Wallhack Logic (ເບິ່ງທະລຸຝາ - ຈຳກັດໄລຍະບໍ່ໃຫ້ໄກໂພດ)
local espActive = false
local espBoxFolder = Instance.new("Folder", SG)
espBoxFolder.Name = "ESPFolder"

EspBtn.MouseButton1Click:Connect(function()
    espActive = not espActive
    if espActive then
        EspBtn.Text = "👀 ESP Wallhack: ON"
        EspBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        EspBtn.Text = "👀 ESP Wallhack: OFF"
        EspBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        espBoxFolder:ClearAllChildren()
    end
end)

local ESP_MAX_DIST = 150 -- ກຳນົດໄລຍະສູງສຸດທີ່ຈະເຫັນ (ປັບຫຼຸດລົງໄດ້ຖ້າບໍ່ຢากໃຫ້ເຫັນໄກ)

rs.RenderStepped:Connect(function()
    if espActive and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local myPos = LP.Character.HumanoidRootPart.Position
        
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
                local hrp = player.Character.HumanoidRootPart
                local hum = player.Character.Humanoid
                local dist = (hrp.Position - myPos).Magnitude
                
                local box = espBoxFolder:FindFirstChild(player.Name)
                if hum.Health > 0 and dist <= ESP_MAX_DIST then
                    if not box then
                        box = Instance.new("Highlight", espBoxFolder)
                        box.Name = player.Name
                        box.FillColor = Color3.fromRGB(255, 0, 0)
                        box.OutlineColor = Color3.fromRGB(255, 255, 255)
                        box.FillTransparency = 0.5
                        box.OutlineTransparency = 0
                    end
                    box.Adornee = player.Character
                else
                    if box then
                        box:Destroy()
                    end
                end
            end
        end
    else
        espBoxFolder:ClearAllChildren()
    end
end)

