    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        LP.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
    end
end)

FlyUpBtn.MouseButton1Down:Connect(function() verticalDir = 1 end)
FlyUpBtn.TouchTap:Connect(function() verticalDir = (verticalDir == 1) and 0 or 1 end)
FlyDownBtn.MouseButton1Down:Connect(function() verticalDir = -1 end)
FlyDownBtn.TouchTap:Connect(function() verticalDir = (verticalDir == -1) and 0 or -1 end)

rs.RenderStepped:Connect(function()
    if flying and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character:FindFirstChild("Humanoid") then
        local hrp = LP.Character.HumanoidRootPart
        local hum = LP.Character.Humanoid
        hrp.Velocity = Vector3.new(0, 1, 0)
        local moveDir = hum.MoveDirection
        local upward = Vector3.new(0, verticalDir * (currentFlySpeed / 15), 0)
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (cam.CFrame.LookVector * Vector3.new(1,0,1)).Unit * moveDir.Magnitude * (currentFlySpeed / 15) + upward
        elseif verticalDir ~= 0 then
            hrp.CFrame = hrp.CFrame + upward
        end
    end
end)

