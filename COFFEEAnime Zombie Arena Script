Content.BackgroundTransparency = 1
Content.Parent = MainFrame

-- Minimize / Expand state
local isMinimized = false
MinMaxBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    Content.Visible = not isMinimized
    MainFrame.Size = isMinimized and miniSize or normalSize
    MinMaxBtn.Text = isMinimized and "+" or "-"
end)

-- Open / Close window state
local isVisible = true
OpenCloseBtn.MouseButton1Click:Connect(function()
    isVisible = not isVisible
    MainFrame.Visible = isVisible
    OpenCloseBtn.Text = isVisible and "Hide GUI" or "Show GUI"
    OpenCloseBtn.BackgroundColor3 = isVisible and Color3.fromRGB(35, 130, 220) or Color3.fromRGB(46, 160, 67)
end)

-- Helper function to create toggle buttons inside Content
local function AddButton(labelText, yPos, onToggle)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 36)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
    btn.Text = labelText .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(235, 235, 235)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.Parent = Content
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = labelText .. (active and ": ON" or ": OFF")
        btn.BackgroundColor3 = active and Color3.fromRGB(46, 160, 67) or Color3.fromRGB(45, 45, 58)
        if onToggle then
            onToggle(active)
        end
    end)
end

-- Example feature buttons
AddButton("Feature 1", 8, function(state)
    print("Feature 1:", state)
end)

AddButton("Feature 2", 52, function(state)
    print("Feature 2:", state)
end)
