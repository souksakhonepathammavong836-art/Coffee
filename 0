local flying = false
local currentFlySpeed = 50

MovementTab:CreateToggle({
   Name = "เปิด/ปิด บิน (Fly)",
   CurrentValue = false,
   Callback = function(v) flying = v end,
})

MovementTab:CreateSlider({
   Name = "ความเร็วในการบิน (Fly Speed)",
   Range = {1, 500},
   Increment = 1,
   CurrentValue = 50,
   Callback = function(v) currentFlySpeed = v end,
})

RS.RenderStepped:Connect(function()
   if flying and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character:FindFirstChild("Humanoid") then
      local hrp = LP.Character.HumanoidRootPart
      local hum = LP.Character.Humanoid
      hrp.Velocity = Vector3.new(0, 1, 0)
      local moveDir = hum.MoveDirection
      if moveDir.Magnitude > 0 then
         hrp.CFrame = hrp.CFrame + (Camera.CFrame.LookVector * Vector3.new(1,0,1)).Unit * moveDir.Magnitude * (currentFlySpeed / 15)
      end
   end
end)

