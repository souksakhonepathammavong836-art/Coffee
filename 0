local hitboxActive = false
CombatTab:CreateToggle({
   Name = "ขยายฮิตบ็อกซ์ตัวละคร (Hitbox 20)",
   CurrentValue = false,
   Callback = function(v)
      hitboxActive = v
   end,
})
task.spawn(function()
   while task.wait(1) do
      if hitboxActive then
         for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
               local hrp = player.Character.HumanoidRootPart
               hrp.Size = Vector3.new(20, 20, 20)
               hrp.Transparency = 0.5
               hrp.CanCollide = false
               if not hrp:FindFirstChild("RedHitboxSelection") then
                  local sb = Instance.new("SelectionBox", hrp)
                  sb.Name = "RedHitboxSelection"
                  sb.Adornee = hrp
                  sb.Color3 = Color3.fromRGB(255, 0, 0)
                  sb.LineThickness = 0.05
               end
            end
         end
      end
   end
end)

local aimbotActive = false
local currentAimbotDist = 85
local currentLockStrength = 0.25

CombatTab:CreateToggle({
   Name = "ล็อกหัวออโต้ (Aimbot)",
   CurrentValue = false,
   Callback = function(v)
      aimbotActive = v
   end,
})

CombatTab:CreateSlider({
   Name = "ระยะล็อกเป้า (Aimbot Distance)",
   Range = {10, 300},
   Increment = 1,
   CurrentValue = 85,
   Callback = function(v) currentAimbotDist = v end,
})

CombatTab:CreateSlider({
   Name = "ความเนียนในการล็อก (Smoothness)",
   Range = {0.05, 1},
   Increment = 0.05,
   CurrentValue = 0.25,
   Callback = function(v) currentLockStrength = v end,
})

RS.RenderStepped:Connect(function()
   if aimbotActive and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
      pcall(function()
         local closestTarget = nil
         local shortestDist = math.huge
         local myPos = LP.Character.HumanoidRootPart.Position
         for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            if player ~= LP and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") then
               local hum = player.Character.Humanoid
               local head = player.Character.Head
               if hum.Health > 0 and (head.Position - myPos).Magnitude <= currentAimbotDist then
                  local screenPt, onScreen = Camera:WorldToViewportPoint(head.Position)
                  if onScreen then
                     local dist = (Vector2.new(screenPt.X, screenPt.Y) - UIS:GetMouseLocation()).Magnitude
                     if dist < shortestDist then
                        shortestDist = dist
                        closestTarget = head
                     end
                  end
               end
            end
         end
         if closestTarget then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closestTarget.Position), currentLockStrength)
         end
      end)
   end
end)

local espActive = false
local espFolder = Instance.new("Folder", workspace)
espFolder.Name = "SpeedHubESP"

CombatTab:CreateToggle({
   Name = "มองทะลุผนัง (ESP Highlight)",
   CurrentValue = false,
   Callback = function(v)
      espActive = v
      if not v then espFolder:ClearAllChildren() end
   end,
})

RS.RenderStepped:Connect(function()
   if espActive and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
      local myPos = LP.Character.HumanoidRootPart.Position
      for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
         if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local hrp = player.Character.HumanoidRootPart
            local hum = player.Character.Humanoid
            local box = espFolder:FindFirstChild(player.Name)
            if hum.Health > 0 and (hrp.Position - myPos).Magnitude <= 150 then
               if not box then
                  box = Instance.new("Highlight", espFolder)
                  box.Name = player.Name
                  box.FillColor = Color3.fromRGB(255, 0, 0)
                  box.FillTransparency = 0.5
               end
               box.Adornee = player.Character
            else
               if box then box:Destroy() end
            end
         end
      end
   end
end)


