-- ຕາຕະລາງເກັບສະຖານະການເລືອກ (True/False)
local selectedRarities = {
    ["Normal"] = false,
    ["Rare"] = false,
    ["Epic"] = false,
    ["Legendary"] = false
}

-- ຟັງຊັນສ້າງປຸ່ມ Checkbox ແຕ່ລະລະດັບ
local function createCheckbox(name, posY, rarityKey)
    local btn = Instance.new("TextButton", Frame)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.Text = "❌ " .. name .. " [OFF]"
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize, btn.Font = 13, Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        selectedRarities[rarityKey] = not selectedRarities[rarityKey]
        if selectedRarities[rarityKey] then
            btn.Text = "✅ " .. name .. " [ON]"
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
        else
            btn.Text = "❌ " .. name .. " [OFF]"
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        end
    end)
    return btn
end

createCheckbox("Normal (ທຳມະດາ)", 40, "Normal")
createCheckbox("Rare (ຫາຍາກ)", 80, "Rare")
createCheckbox("Epic", 120, "Epic")
createCheckbox("Legendary", 160, "Legendary")

