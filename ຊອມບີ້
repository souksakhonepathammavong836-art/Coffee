-- Kill Aura Logic (Teleports tools or attacks nearby enemies/mobs)
local auraActive = false
AuraBtn.MouseButton1Click:Connect(function()
    auraActive = not auraActive
    if auraActive then
        AuraBtn.Text = "⚔️ Kill Aura (Auto Hit): ON"
        AuraBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
    else
        AuraBtn.Text = "⚔️ Kill Aura (Auto Hit): OFF"
        AuraBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end
end)

task.spawn(function()
    while task.wait(0.2) do
        if auraActive and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local myPos = LP.Character.HumanoidRootPart.Position
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                        if obj ~= LP.Character and obj.Humanoid.Health > 0 then
                            -- Check if it's an enemy/zombie (not a player)
                            local isPlayer = false
                            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                                if p.Character == obj then isPlayer = true end
                            end
                            if not isPlayer then
                                local dist = (obj.HumanoidRootPart.Position - myPos).Magnitude
                                if dist <= 25 then
                                    -- Auto pull/attack logic if applicable
                                    obj.HumanoidRootPart.CFrame = LP.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- ESP Zombies
local espActive = false
local espFolder = Instance.new("Folder", SG)
espFolder.Name = "ZombieESP"

EspBtn.MouseButton1Click:Connect(function()
    espActive = not espActive
    if espActive then
        EspBtn.Text = "👀 ESP Zombies: ON"
        EspBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
    else
        EspBtn.Text = "👀 ESP Zombies: OFF"
        EspBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        espFolder:ClearAllChildren()
    end
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if espActive and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local myPos = LP.Character.HumanoidRootPart.Position
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                local isPlayer = false
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    if p.Character == obj then isPlayer = true end
                end
                if not isPlayer and obj.Humanoid.Health > 0 then
                    local box = espFolder:FindFirstChild(obj.Name)
                    if not box then
                        box = Instance.new("Highlight", espFolder)
                        box.Name = obj.Name
                        box.FillColor = Color3.fromRGB(255, 50, 50)
                        box.OutlineColor = Color3.fromRGB(255, 255, 255)
                        box.FillTransparency = 0.5
                    end
                    box.Adornee = obj
                end
            end
        end
    else
        espFolder:ClearAllChildren()
    end
end)

