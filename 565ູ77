-- ລະບົບການເຮັດວຽກ
local isFarmActive = false
farmBtn.MouseButton1Click:Connect(function()
    isFarmActive = not isFarmActive
    if isFarmActive then
        farmBtn.Text = "GOD FARM: ON"
        farmBtn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        farmBtn.Text = "GOD FARM: OFF"
        farmBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

-- ຟັງຊັ່ນກວາດລ້າງມອນສະເຕີແບບລະອຽດ
task.spawn(function()
    while true do
        task.wait(0.05)
        if isFarmActive then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPos = char.HumanoidRootPart.Position
                    
                    -- 1. ບັງຄັບເປີດໃຊ້ Tool (ອາວຸດ) ໃນມືໃຫ້ຕີອັດຕະໂນມັດ
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    end

                    -- 2. ຊອກົກຫາໃນ Workspace ທົ່ວໄປ ແລະ ໂຟນເດີມອນ ( Enemies / Mobs / Monsters )
                    local searchFolders = {workspace, workspace:FindFirstChild("Mobs"), workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Monsters")}
                    
                    for _, folder in pairs(searchFolders) do
                        if folder then
                            for _, obj in pairs(folder:GetDescendants()) do
                                if obj:IsA("Humanoid") and obj.Parent ~= char then
                                    local enemyRoot = obj.Parent:FindFirstChild("HumanoidRootPart") or obj.Parent:FindFirstChild("Torso") or obj.Parent:FindFirstChild("Head")
                                    if enemyRoot then
                                        if (rootPos - enemyRoot.Position).Magnitude <= 200 then
                                            obj.Health = 0 -- ຕັດເລືອດໃຫ້ເຫຼືອ 0
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

tpBtn.MouseButton1Click:Connect(function()
    pcall(function()
        local sellPart = workspace:FindFirstChild("SellPart") or workspace:FindFirstChild("Shop")
        if sellPart and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = sellPart.CFrame + Vector3.new(0, 3, 0)
        end
    end)
end)

closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

print("Advanced God Farm Loaded!")
