RunService.Heartbeat:Connect(function()
    if not universalFastActive then return end
    pcall(function()
        -- 1. ເລັ່ງຄວາມໄວ ແລະ ລຶບ Cooldown ໃນ Tool ທີ່ຖືຢູ່ (ຂຸດແຮ່, ຕັດໄມ້, ຕີ)
        if LP.Character then
            local tool = LP.Character:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
                for _, descendant in ipairs(tool:GetDescendants()) do
                    if descendant:IsA("NumberValue") or descendant:IsA("IntValue") then
                        local n = descendant.Name:lower()
                        if n:find("cooldown") or n:find("cd") or n:find("delay") or n:find("speed") or n:find("rate") or n:find("time") then
                            descendant.Value = 0.00001
                        elseif n:find("damage") or n:find("dmg") or n:find("power") or n:find("strength") then
                            descendant.Value = 9999999
                        end
                    elseif descendant:IsA("RemoteEvent") then
                        local n = descendant.Name:lower()
                        if n:find("hit") or n:find("mine") or n:find("chop") or n:find("gather") or n:find("break") or n:find("tool") then
                            descendant:FireServer()
                        end
                    end
                end
            end
        end

        -- 2. ເລັ່ງ ProximityPrompt (ກົດເກັບຂອງ / ເປີດປະຕູ / ວຽກຕ່າງໆ ໃຫ້ຕິດທັນທີ)
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                v.HoldDuration = 0
                v.MaxActivationDistance = math.max(v.MaxActivationDistance, 30)
            end
        end
    end)
end)

