-- Logic Variables & Handlers
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local dragging = false
SliderButton.MouseButton1Down:Connect(function() dragging = true end)

local flyDragging = false
local currentFlySpeed = 500
FlySliderButton.MouseButton1Down:Connect(function() flyDragging = true end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        flyDragging = false
    end
end)

-- WalkSpeed Logic (Default 500)
local walkSpeedActive = false
local currentWalkSpeed = 500

WalkSpeedToggleBtn.MouseButton1Click:Connect(function()
    walkSpeedActive = not walkSpeedActive
    if walkSpeedActive then
        WalkSpeedToggleBtn.Text = "⚡ WalkSpeed Boost: ON (500)"
        WalkSpeedToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        if LP.Character and LP.Character:FindFirstChild("Humanoid") then
            LP.Character.Humanoid.WalkSpeed = currentWalkSpeed
        end
    else
        WalkSpeedToggleBtn.Text = "⚡ WalkSpeed Boost: OFF"
        WalkSpeedToggleBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        if LP.Character and LP.Character:FindFirstChild("Humanoid") then
            LP.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if (dragging or flyDragging) and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local mousePos = UIS:GetMouseLocation()
        if dragging then
            local absPos = SliderBg.AbsolutePosition
            local absSize = SliderBg.AbsoluteSize
            local relX = math.clamp((mousePos.X - absPos.X) / absSize.X, 0, 1)
            currentWalkSpeed = math.floor(1 + relX * (1000 - 1))
            SliderFill.Size = UDim2.new(relX, 0, 1, 0)
            SliderText.Text = "Walk Speed: " .. currentWalkSpeed
            if walkSpeedActive and LP.Character and LP.Character:FindFirstChild("Humanoid") then
                LP.Character.Humanoid.WalkSpeed = currentWalkSpeed
            end
        elseif flyDragging then
            local absPos = FlySliderBg.AbsolutePosition
            local absSize = FlySliderBg.AbsoluteSize
            local relX = math.clamp((mousePos.X - absPos.X) / absSize.X, 0, 1)
            currentFlySpeed = math.floor(1 + relX * (2000 - 1))
            FlySliderFill.Size = UDim2.new(relX, 0, 1, 0)
            FlySliderText.Text = "Fly Speed: " .. currentFlySpeed
        end
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if walkSpeedActive and LP.Character and LP.Character:FindFirstChild("Humanoid") then
            if LP.Character.Humanoid.WalkSpeed ~= currentWalkSpeed then
                LP.Character.Humanoid.WalkSpeed = currentWalkSpeed
            end
        end
    end
end)

