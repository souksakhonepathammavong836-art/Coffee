local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")
local PlayerGui = LP:WaitForChild("PlayerGui")

-- ປ້ອງກັນການສ້າງຊ້ອນ
if CoreGui:FindFirstChild("CoffeeVIPMobileFixed") then
    CoreGui.CoffeeVIPMobileFixed:Destroy()
end
if PlayerGui:FindFirstChild("CoffeeVIPMobileFixed") then
    PlayerGui.CoffeeVIPMobileFixed:Destroy()
end

local SG = Instance.new("ScreenGui")
SG.Name = "CoffeeVIPMobileFixed"
SG.ResetOnSpawn = false

-- ພະຍາຍາມເອົາໄປໃສ່ CoreGui ກ່ອນ (ຖ້າ Executor ຮອງຮັບ ຈະບໍ່ຫຼຸດເວລາຕາຍ)
local success = pcall(function()
    SG.Parent = CoreGui
end)
if not success then
    SG.Parent = PlayerGui
end

