-- รวมสคริปต์แอดมิน + ระบบ GUI อัตโนมัติ (Server Script)
local Players = game:GetService("Players")

-- รายชื่อแอดมิน ใส่ UserId ของคุณ
local ADMINS = {
	[12345678] = true, -- <--- ⚠️ เปลี่ยนเป็น UserId ของคุณตรงนี้!
}

local function getParts(plr)
	local c = plr.Character
	return c, c and c:FindFirstChildOfClass("Humanoid"), c and c:FindFirstChild("HumanoidRootPart")
end

local commands = {
	god = function(plr, hum)
		hum.MaxHealth = math.huge
		hum.Health = math.huge
	end,
	heal = function(plr, hum)
		hum.Health = hum.MaxHealth
	end,
	speed = function(plr, hum, root, arg)
		hum.WalkSpeed = tonumber(arg) or 100
	end,
	jump = function(plr, hum, root, arg)
		hum.UseJumpPower = true
		hum.JumpPower = tonumber(arg) or 150
	end,
	coffee = function(plr, hum, root, arg)
		local c = plr:FindFirstChild("leaderstats") and plr.leaderstats:FindFirstChild("Coffee")
		if c then c.Value += tonumber(arg) or 1000 end
	end,
	big = function(plr, hum)
		for _, n in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}) do
			local v = hum:FindFirstChild(n)
			if v then v.Value = 3 end
		end
	end,
	small = function(plr, hum)
		for _, n in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}) do
			local v = hum:FindFirstChild(n)
			if v then v.Value = 0.5 end
		end
	end,
	fire = function(plr, hum, root)
		if not root:FindFirstChildOfClass("Fire") then
			local f = Instance.new("Fire")
			f.Size = 10
			f.Parent = root
		end
	end,
	invis = function(plr, hum, root, arg, char)
		if not char then return end
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") or p:IsA("Decal") then
				if p.Name ~= "HumanoidRootPart" then 
					p.Transparency = (p.Transparency == 1) and 0 or 1 
				end
			end
		end
	end,
	sword = function(plr)
		local tool = Instance.new("Tool")
		tool.Name = "ดาบสุดโกง"
		local h = Instance.new("Part")
		h.Name = "Handle"
		h.Size = Vector3.new(1, 0.4, 6)
		h.Material = Enum.Material.Neon
		h.Color = Color3.fromRGB(255, 80, 0)
		h.Parent = tool
		
		local swing = false
		tool.Activated:Connect(function()
			swing = true
			task.delay(0.4, function() swing = false end)
		end)
		
		h.Touched:Connect(function(o)
			local th = o.Parent:FindFirstChildOfClass("Humanoid")
			if swing and th and o.Parent ~= tool.Parent then
				th.Health = 0
			end
		end)
		tool.Parent = plr.Backpack
	end,
	nuke = function(plr, hum, root)
		local count = 0
		for _, o in ipairs(Players:GetPlayers()) do
			local c, h, r = getParts(o)
			if o ~= plr and h and r and (r.Position - root.Position).Magnitude < 60 then
				h.Health = 0
				count += 1
			end
		end
		local e = Instance.new("Explosion")
		e.Position = root.Position
		e.BlastRadius = 30
		e.BlastPressure = 0
		e.Parent = workspace
	end,
}

-- ฟังก์ชันสร้าง GUI สำหรับแอดมินแต่ละคนโดยเฉพาะ
local function setupAdminGui(plr)
	local playerGui = plr:WaitForChild("PlayerGui")
	
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "AdminGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local mainFrame = Instance.new("Frame")
	mainFrame.Size = UDim2.new(0, 220, 0, 420)
	mainFrame.Position = UDim2.new(0, 20, 0.5, -210)
	mainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	mainFrame.BorderSizePixel = 0
	mainFrame.Active = true
	mainFrame.Draggable = true
	mainFrame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = mainFrame

	local topBar = Instance.new("Frame")
	topBar.Size = UDim2.new(1, 0, 0, 40)
	topBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	topBar.BorderSizePixel = 0
	topBar.Parent = mainFrame

	local topCorner = Instance.new("UICorner")
	topCorner.CornerRadius = UDim.new(0, 8)
	topCorner.Parent = topBar

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -40, 1, 0)
	title.Position = UDim2.new(0, 10, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = "⚡ ADMIN PANEL"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextSize = 16
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = topBar

	local minBtn = Instance.new("TextButton")
	minBtn.Size = UDim2.new(0, 30, 0, 30)
	minBtn.Position = UDim2.new(1, -35, 0, 5)
	minBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	minBtn.Text = "-"
	minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	minBtn.TextSize = 18
	minBtn.Font = Enum.Font.GothamBold
	minBtn.Parent = topBar

	local minCorner = Instance.new("UICorner")
	minCorner.CornerRadius = UDim.new(0, 6)
	minCorner.Parent = minBtn

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -10, 1, -50)
	scroll.Position = UDim2.new(0, 5, 0, 45)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.CanvasSize = UDim2.new(0, 0, 0, 500)
	scroll.ScrollBarThickness = 6
	scroll.Parent = mainFrame

	local uiLayout = Instance.new("UIListLayout")
	uiLayout.Padding = UDim.new(0, 8)
	uiLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	uiLayout.Parent = scroll

	local function addButton(name, cmdName, arg)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 190, 0, 35)
		btn.BackgroundColor3 = Color3.fromRGB(60, 120, 216)
		btn.Text = name
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.TextSize = 14
		btn.Font = Enum.Font.GothamSemibold
		btn.Parent = scroll
		
		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 6)
		btnCorner.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			local fn = commands[cmdName]
			if fn then
				local char, hum, root = getParts(plr)
				if char and hum and root then
					fn(plr, hum, root, arg, char)
				end
			end
		end)
	end

	-- สร้างปุ่มคำสั่งทั้งหมด
	addButton("อมตะ (God)", "god")
	addButton("เติมเลือดเต็ม (Heal)", "heal")
	addButton("วิ่งเร็ว (Speed 150)", "speed", 150)
	addButton("กระโดดสูง (Jump 150)", "jump", 150)
	addButton("เพิ่ม Coffee (1,000)", "coffee", 1000)
	addButton("ตัวใหญ่ (Big)", "big")
	addButton("ตัวเล็ก (Small)", "small")
	addButton("ไฟลุก (Fire)", "fire")
	addButton("ล่องหน (Invis)", "invis")
	addButton("เสกดาบโกง (Sword)", "sword")
	addButton("ระเบิดนิวเคลียร์ (Nuke)", "nuke")

	-- ระบบย่อ/ขยายหน้าต่าง
	local minimized = false
	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		scroll.Visible = not minimized
		if minimized then
			mainFrame.Size = UDim2.new(0, 220, 0, 40)
			minBtn.Text = "+"
		else
			mainFrame.Size = UDim2.new(0, 220, 0, 420)
			minBtn.Text = "-"
		end
	end)
end

-- ตรวจสอบผู้เล่นเมื่อเข้าเกม
Players.PlayerAdded:Connect(function(plr)
	if ADMINS[plr.UserId] then
		setupAdminGui(plr)
	end
	
	-- รองรับการพิมพ์คำสั่งผ่านช่องแชทควบคู่กันไป
	plr.Chatted:Connect(function(msg)
		if not ADMINS[plr.UserId] then return end
		local cmd, arg = msg:match("^[/!:](%w+)%s*(.*)$")
		local fn = cmd and commands[cmd:lower()]
		if not fn then return end
		local char, hum, root = getParts(plr)
		if char and hum and root then
			fn(plr, hum, root, arg ~= "" and arg or nil, char)
		end
	end)
end)
