-- [[ GREEDY GROWERS - SMART TEXT-BASED TIER SEED BUYER ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

pcall(function()
    if LP.PlayerGui:FindFirstChild("SmartTierHub") then
        LP.PlayerGui.SmartTierHub:Destroy()
    end
end)

local SG = Instance.new("ScreenGui")
SG.Name = "SmartTierHub"
SG.Parent = LP:WaitForChild("PlayerGui")
SG.ResetOnSpawn = false

-- ຫຼັກ GUI Frame
local Frame = Instance.new("Frame", SG)
Frame.Size = UDim2.new(0, 220, 0, 290)
Frame.Position = UDim2.new(0.5, -110, 0.2, 0)
Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true
Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)

-- Title
local Title = Instance.new("TextLabel", Frame)
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "  Smart Tier & Buy"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize, Title.Font = 14, Enum.Font.SourceSansBold
Title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Title.TextXAlignment = Enum.TextXAlignment.Left
Instance.new("UICorner", Title).CornerRadius = UDim.new(0, 10)

local toggles = {
    Normal = false,
    Rare = false,
    Epic = false,
    Legendary = false,
    MasterTrigger = false,
    Minimized = false
}

-- ປຸ່ມຫຍໍ້/ຂະຫຍາຍ (- / +)
local MinBtn = Instance.new("TextButton", Frame)
MinBtn.Size = UDim2.new(0, 30, 0, 30)
MinBtn.Position = UDim2.new(1, -33, 0, 2)
MinBtn.Text = "-"
MinBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
MinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
MinBtn.TextSize, MinBtn.Font = 16, Enum.Font.SourceSansBold
Instance.new("UICorner", MinBtn).CornerRadius = UDim.new(0, 6)

MinBtn.MouseButton1Click:Connect(function()
    toggles.Minimized = not toggles.Minimized
    if toggles.Minimized then
        MinBtn.Text = "+"
        Frame.Size = UDim2.new(0, 220, 0, 35)
        for _, obj in ipairs(Frame:GetChildren()) do
            if obj ~= Title and obj ~= MinBtn then
                obj.Visible = false
            end
        end
    else
        MinBtn.Text = "-"
        Frame.Size = UDim2.new(0, 220, 0, 290)
        for _, obj in ipairs(Frame:GetChildren()) do
            obj.Visible = true
        end
    end
end)

local function createTierButton(name, posY, tierKey)
    local btn = Instance.new("TextButton", Frame)
    btn.Size = UDim2.new(0, 200, 0, 30)
    btn.Position = UDim2.new(0.5, -100, 0, posY)
    btn.Text = name .. ": OFF"
    btn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
