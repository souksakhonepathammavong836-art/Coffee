-- Logic & Sliders
local UIS = game:GetService("UserInputService")
local aimbotDragging = false
local currentAimbotDist = 150

AimbotSliderButton.MouseButton1Down:Connect(function() aimbotDragging = true end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        aimbotDragging = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if aimbotDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local mousePos = UIS:GetMouseLocation()
        local absPos = AimbotSliderBg.AbsolutePosition
        local absSize = AimbotSliderBg.AbsoluteSize
        local relX = math.clamp((mousePos.X - absPos.X) / absSize.X, 0, 1)
        currentAimbotDist = math.floor(50 + relX * (500 - 50))
        AimbotSliderFill.Size = UDim2.new(relX, 0, 1, 0)
        AimbotSliderText.Text = "Aimbot Dist: " .. currentAimbotDist
    end
end)

