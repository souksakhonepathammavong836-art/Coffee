-- สคริปต์ค้นหาและย้ายไปเซิร์ฟเวอร์ที่มีคนน้อย (Server Hop)
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local PlaceId = game.PlaceId

local function hopToLowPlayerServer()
    local servers = {}
    
    local success, result = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            -- ตรวจสอบว่าเซิร์ฟเวอร์ยังมีที่ว่าง และคนน้อยกว่าจำนวนสูงสุด
            if server.playing and server.maxPlayers and server.playing < server.maxPlayers then
                if server.id ~= game.JobId then
                    table.insert(servers, server)
                end
            end
        end
        
        if #servers > 0 then
            -- สุ่มเลือกเซิร์ฟเวอร์จากกลุ่มที่มีคนน้อยที่สุด (เรียงจากน้อยไปมากตาม API)
            local targetServer = servers[math.random(1, math.min(5, #servers))]
            TeleportService:TeleportToPlaceInstance(PlaceId, targetServer.id, Players.LocalPlayer)
        else
            print("ไม่พบเซิร์ฟเวอร์อื่นในขณะนี้")
        end
    else
        print("ไม่สามารถดึงข้อมูลเซิร์ฟเวอร์ได้")
    end
end

hopToLowPlayerServer()
