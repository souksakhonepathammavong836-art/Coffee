-- Loop Functions & Improved No Cooldown Bypass
RunService.RenderStepped:Connect(function()
    -- 1. Enhanced No Cooldown Logic (Bypasses tool delays and remote timers)
    if state.noCD then
        pcall(function()
            local char = LP.Character
            local backpack = LP:FindFirstChild("Backpack")
            
            local function processContainer(container)
                if not container then return end
                for _, tool in ipairs(container:GetChildren()) do
                    if tool:IsA("Tool") then
                        -- Activate tool automatically or clear attributes/values
                        for _, v in ipairs(tool:GetDescendants()) do
                            if v:IsA("NumberValue") or v:IsA("IntValue") then
                                local name = v.Name:lower()
                                if name:find("cooldown") or name:find("cd") or name:find("delay") or name:find("reload") or name:find("wait") or name:find("time") then
                                    v.Value = 0
                                end
                            elseif v:IsA("LocalScript") or v:IsA("Script") then
                                -- Disable check bounds if possible, or bypass values
                            end
                        end
                    end
                end
            end

            if char then processContainer(char) end
            if backpack then processContainer(backpack) end
        end)
    end

    -- 2. God Mode Logic
    if state.god and LP.Character and LP.Character:FindFirstChild("Humanoid") then
        LP.Character.Humanoid.Health = LP.Character.Humanoid.MaxHealth
    end
end)

