-- ຟັງຊັນສ້າງປຸ່ມແບບງ່າຍ (Helper function)
local function createButton(name, text, yPos, color)
    local btn = Instance.new("TextButton", ContentContainer)
    btn.Name = name
    btn.Size = UDim2.new(0, 230, 0, 32)
    btn.Position = UDim2.new(0, 15, 0, yPos)
    btn.Text = text
    btn.BackgroundColor3 = color or Color3.fromRGB(80, 80, 80)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize, btn.Font = 11, Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    return btn
end

