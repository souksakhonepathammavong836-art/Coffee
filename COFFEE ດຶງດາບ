-- 2. Fast Attack Logic
local fastAtkActive = false
FastAtkBtn.MouseButton1Click:Connect(function()
    fastAtkActive = not fastAtkActive
    FastAtkBtn.Text = fastAtkActive and "⚡ Fast Attack (9999999): ON" or "⚡ Fast Attack (9999999): OFF"
    FastAtkBtn.BackgroundColor3 = fastAtkActive and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(100, 100, 100)
end)

RunService.RenderStepped:Connect(function()
    if fastAtkActive and LP.Character then
        pcall(function()
            local tool = LP.Character:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
                for _, descendant in ipairs(tool:GetDescendants()) do
                    if descendant:IsA("NumberValue") or descendant:IsA("IntValue") then
                        local n = descendant.Name:lower()
                        if n:find("cooldown") or n:find("cd") or n:find("delay") or n:find("speed") then
                            descendant.Value = 0.0000001
                        elseif n:find("damage") or n:find("dmg") then
                            descendant.Value = 9999999
                        end
                    elseif descendant:IsA("RemoteEvent") then
                        if descendant.Name:lower():find("attack") or descendant.Name:lower():find("hit") then
                            descendant:FireServer(9999999)
                        end
                    end
                end
            end
        end)
    end
end)

-- 3. Custom AOE Melee Logic (Radius 15 + ForceField Bypass)
local customToolActive = false
CustomToolBtn.MouseButton1Click:Connect(function()
    customToolActive = not customToolActive
    CustomToolBtn.Text = customToolActive and "🔥 Custom AOE Melee (Radius 15): ON" or "🔥 Custom AOE Melee (Radius 15): OFF"
    CustomToolBtn.BackgroundColor3 = customToolActive and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(100, 100, 100)
end)

local customParams = OverlapParams.new()
customParams.FilterType = Enum.RaycastFilterType.Exclude

RunService.Heartbeat:Connect(function()
    if not customToolActive then return end
    pcall(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        customParams.FilterDescendantsInstances = {char}

        local parts = workspace:GetPartBoundsInRadius(root.Position + root.CFrame.LookVector * 5, 15, customParams)
        local done = {}
        for _, part in ipairs(parts) do
            local hum = part.Parent:FindFirstChildOfClass("Humanoid")
            if hum and not done[hum] and hum.Health > 0 then
                done[hum] = true
                for _ = 1, 3 do hum:TakeDamage(math.huge) end
                hum.Health = 0
            end
        end
    end)
end)

