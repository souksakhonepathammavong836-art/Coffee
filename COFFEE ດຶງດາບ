-- 6. ESP Wallhack Logic
local espActive = false
local espBoxFolder = Instance.new("Folder", SG)
espBoxFolder.Name = "ESPFolder"

EspBtn.MouseButton1Click:Connect(function()
    espActive = not espActive
    EspBtn.Text = espActive and "👀 ESP Wallhack: ON" or "👀 ESP Wallhack: OFF"
    EspBtn.BackgroundColor3 = espActive and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(100, 100, 100)
    if not espActive then espBoxFolder:ClearAllChildren() end
end)

RunService.RenderStepped:Connect(function()
    if espActive and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local myPos = LP.Character.HumanoidRootPart.Position
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
                local hrp = player.Character.HumanoidRootPart
                local hum = player.Character.Humanoid
                local box = espBoxFolder:FindFirstChild(player.Name)
                if hum.Health > 0 and (hrp.Position - myPos).Magnitude <= 200 then
                    if not box then
                        box = Instance.new("Highlight", espBoxFolder)
                        box.Name = player.Name
                        box.FillColor = Color3.fromRGB(255, 0, 0)
                        box.FillTransparency = 0.4
                    end
                    box.Adornee = player.Character
                elseif box then
                    box:Destroy()
                end
            end
        end
    else
        espBoxFolder:ClearAllChildren()
    end
end)

