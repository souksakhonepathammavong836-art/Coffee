-- [[ GREEDY GROWERS - ULTIMATE SAFE SEEDS BUYER ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("UltimateSafeSeeds") then
    PlayerGui.UltimateSafeSeeds:Destroy()
end

local SG = Instance.new("ScreenGui")
SG.Name = "UltimateSafeSeeds"
SG.Parent = PlayerGui
SG.ResetOnSpawn = false

local Btn = Instance.new("TextButton", SG)
Btn.Size = UDim2.new(0, 200, 0, 50)
Btn.Position = UDim2.new(0.5, -100, 0.2, 0)
Btn.Text = "Safe Seeds: OFF"
Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.TextSize, Btn.Font = 15, Enum.Font.SourceSansBold
Btn.Active = true
Btn.Draggable = true
Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 10)

local autoActive = false
Btn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    if autoActive then
        Btn.Text = "Safe Seeds: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        Btn.Text = "Safe Seeds: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- ລະບົບກວດຈັບທີ່ກັ່ນຕອງປຸ່ມລາງວັນ ແລະ ໄລຟ์ ອອກ 100%
task.spawn(function()
    while task.wait(0.15) do
        if autoActive then
            pcall(function()
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        local fullName = v:GetFullName():lower()
                        local parentPart = v.Parent
                        
                        -- ຕັດປຸ່ມລາງວັນ, Like, Shop, GUI ອອກທັງໝົດ
                        if not fullName:find("like") and not fullName:find("reward") and not fullName:find("shop") and not fullName:find("gui") and not fullName:find("claim") then
                            if parentPart and parentPart:IsA("BasePart") then
                                local isRealSeed = false
                                
                                -- ກວດສອບຊື່ໃນ Model ວ່າຕ້ອງເປັນກ່ອງເມັດພັນເທິງສາຍພານ
                                local model = parentPart.Parent
                                if model and model:IsA("Model") then
                                    local mName = model.Name:lower()
                                    if mName:find("seed") or mName:find("box") or mName:find("conveyor") then
                                        isRealSeed = true
                                    end
                                end
                                
                                -- ຖ້າຜ່ານທຸກເງື່ອນໄຂ ຖືว่าเป็นເມັດພັນແທ້ ຈຶ່ງກົດຊື້
                                if isRealSeed then
                                    v.MaxActivationDistance = 999999
                                    v.RequiresLineOfSight = false
                                    fireproximityprompt(v)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
