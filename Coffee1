-- [[ GREEDY GROWERS - AUTO BUY WITH RARITY FILTER ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("AutoBuyFilter") then
    PlayerGui.AutoBuyFilter:Destroy()
end

local SG = Instance.new("ScreenGui", PlayerGui)
SG.Name = "AutoBuyFilter"

local Frame = Instance.new("Frame", SG)
Frame.Size = UDim2.new(0, 240, 0, 180)
Frame.Position = UDim2.new(0.5, -120, 0.4, -90)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Active = true
Frame.Draggable = true
Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

local Title = Instance.new("TextLabel", Frame)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "🌱 Auto Buy (Filter System)"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize, Title.Font = 13, Enum.Font.SourceSansBold
Title.BackgroundTransparency = 1

-- ປຸ່ມເປີດ/ປິດ Auto Buy
local ToggleBtn = Instance.new("TextButton", Frame)
ToggleBtn.Size = UDim2.new(0.9, 0, 0, 35)
ToggleBtn.Position = UDim2.new(0.05, 0, 0.2, 0)
ToggleBtn.Text = "Status: OFF"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 13
ToggleBtn.Font = Enum.Font.SourceSansBold
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 6)

-- ປຸ່ມເລືອກລະດັບ (Common / Rare / Epic / Legendary)
local RarityBtn = Instance.new("TextButton", Frame)
RarityBtn.Size = UDim2.new(0.9, 0, 0, 35)
RarityBtn.Position = UDim2.new(0.05, 0, 0.45, 0)
RarityBtn.Text = "Target Rarity: All (ທັງໝົດ)"
RarityBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
RarityBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
RarityBtn.TextSize, RarityBtn.Font = 12, Enum.Font.SourceSansBold
Instance.new("UICorner", RarityBtn).CornerRadius = UDim.new(0, 6)

-- ປຸ່ມປິດ Hub
local CloseBtn = Instance.new("TextButton", Frame)
CloseBtn.Size = UDim2.new(0.9, 0, 0, 30)
CloseBtn.Position = UDim2.new(0.05, 0, 0.72, 0)
CloseBtn.Text = "❌ Close Hub"
CloseBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.TextSize, CloseBtn.Font = 12, Enum.Font.SourceSansBold
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)

local autoActive = false
local rarities = {"All", "ທຳມະດາ", "หายาก", "Epic", "Legendary"}
local currentRarityIndex = 1

ToggleBtn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    if autoActive then
        ToggleBtn.Text = "Status: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        ToggleBtn.Text = "Status: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

RarityBtn.MouseButton1Click:Connect(function()
    currentRarityIndex = currentRarityIndex + 1
    if currentRarityIndex > #rarities then
        currentRarityIndex = 1
    end
    RarityBtn.Text = "Target Rarity: " .. rarities[currentRarityIndex]
end)

CloseBtn.MouseButton1Click:Connect(function()
    SG:Destroy()
end)

-- ລະບົບຊື້ຕາມລະດັບທີ່ເລືອກ
task.spawn(function()
    while task.wait(0.5) do
        if autoActive then
            pcall(function()
                local char = LP.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local originalPos = hrp.CFrame
                    
                    for _, v in ipairs(workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") then
                            local parentPart = v.Parent
                            if parentPart and parentPart:IsA("BasePart") then
                                local targetRarity = rarities[currentRarityIndex]
                                local shouldBuy = false
                                
                                if targetRarity == "All" then
                                    shouldBuy = true
                                else
                                    -- ກວດສອບຊື່ ຫຼື ป້າຍກຳກັບລະດັບຂອງເມັດພັນ
                                    for _, desc in ipairs(parentPart:GetDescendants()) do
                                        if desc:IsA("TextLabel") and desc.Text:lower():find(targetRarity:lower()) then
                                            shouldBuy = true
                                            break
                                        end
                                    end
                                end
                                
                                if shouldBuy then
                                    hrp.CFrame = parentPart.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.05)
                                    fireproximityprompt(v)
                                    task.wait(0.05)
                                end
                            end
                        end
                    end
                    hrp.CFrame = originalPos
                end
            end)
        end
    end
end)
