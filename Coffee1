-- [[ GREEDY GROWERS - STRICT CONVEYOR ONLY AUTO BUY ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("StrictBeltHub") then
    PlayerGui.StrictBeltHub:Destroy()
end

local SG = Instance.new("ScreenGui")
SG.Name = "StrictBeltHub"
SG.Parent = PlayerGui
SG.ResetOnSpawn = false

local Btn = Instance.new("TextButton", SG)
Btn.Size = UDim2.new(0, 200, 0, 50)
Btn.Position = UDim2.new(0.5, -100, 0.2, 0)
Btn.Text = "Strict Auto Buy: OFF"
Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.TextSize, Btn.Font = 15, Enum.Font.SourceSansBold
Btn.Active = true
Btn.Draggable = true
Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 10)

local autoActive = false
Btn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    if autoActive then
        Btn.Text = "Strict Auto Buy: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        Btn.Text = "Strict Auto Buy: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- ລະບົບກວດຈັບສະເພາະກ່ອງເມັດພັນ (ປ້ອງກັນການໄປໂດນປຸ່ມຮ້ານຄ້າ)
task.spawn(function()
    while task.wait(0.15) do
        if autoActive then
            pcall(function()
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        local part = v.Parent
                        if part and part:IsA("BasePart") then
                            -- ຂ້າມ (Ignore) ຖ້າຫາກ Prompt ຕິດຢູ່ກັບ UI ຫຼື Shop
                            local fullName = v:GetFullName():lower()
                            if not fullName:find("shop") and not fullName:find("gui") and not fullName:find("menu") then
                                local model = part.Parent
                                if model and model:IsA("Model") then
                                    -- ກວດສອບວ່າເປັນກ່ອງເມັດພັນທີ່ไหลມາຕາມສາຍພານ (ເຊັ່ນ: ມີ Object 3D ປະເພດ Box ຫຼຶ Seed)
                                    if model.Name:lower():find("seed") or model.Name:lower():find("box") or model.Name:lower():find("part") then
                                        v.MaxActivationDistance = 999999
                                        v.RequiresLineOfSight = false
                                        fireproximityprompt(v)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
