-- [[ GREEDY GROWERS - SAFE BELT SEED BUYER ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("SafeBeltHub") then
    PlayerGui.SafeBeltHub:Destroy()
end

local SG = Instance.new("ScreenGui")
SG.Name = "SafeBeltHub"
SG.Parent = PlayerGui
SG.ResetOnSpawn = false

local Btn = Instance.new("TextButton", SG)
Btn.Size = UDim2.new(0, 200, 0, 50)
Btn.Position = UDim2.new(0.5, -100, 0.2, 0)
Btn.Text = "Safe Auto Buy: OFF"
Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.TextSize, Btn.Font = 15, Enum.Font.SourceSansBold
Btn.Active = true
Btn.Draggable = true
Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 10)

local autoActive = false
Btn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    if autoActive then
        Btn.Text = "Safe Auto Buy: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        Btn.Text = "Safe Auto Buy: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- ລະບົບກວດຈັບສະເພາະ ProximityPrompt ທີ່ຢູ່ໃນພື້ນທີ່ສາຍພານ 3D (Workspace) ເທົ່ານັ້ນ
task.spawn(function()
    while task.wait(0.15) do
        if autoActive then
            pcall(function()
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        local part = v.Parent
                        -- ກວດສອບວ່າ ProximityPrompt ນີ້ຕິດຢູ່ກັບ Model ະລາວ/ກ່ອງເມັດພັນ ຢູ່ໃນ Workspace 
                        if part and part:IsA("BasePart") then
                            local model = part.Parent
                            if model and (model:IsA("Model") or model:IsA("Folder")) then
                                local nameLower = model.Name:lower()
                                local parentNameLower = model.Parent and model.Parent.Name:lower() or ""
                                
                                -- ຖ້າພົບວ່າຢູ່ໃນເສັ້ນທາງສາຍພານ ຫຼື ມີຄຳວ່າ seed / box / conveyor
                                if nameLower:find("seed") or nameLower:find("box") or parentNameLower:find("belt") or parentNameLower:find("conveyor") or parentNameLower:find("river") then
                                    v.MaxActivationDistance = 999999
                                    v.RequiresLineOfSight = false
                                    fireproximityprompt(v)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
