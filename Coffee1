-- [[ GREEDY GROWERS - ONLY SEEDS (NO FERTILIZER / NO SHOP) ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("OnlySeedsFinal") then
    PlayerGui.OnlySeedsFinal:Destroy()
end

local SG = Instance.new("ScreenGui")
SG.Name = "OnlySeedsFinal"
SG.Parent = PlayerGui
SG.ResetOnSpawn = false

local Btn = Instance.new("TextButton", SG)
Btn.Size = UDim2.new(0, 200, 0, 50)
Btn.Position = UDim2.new(0.5, -100, 0.2, 0)
Btn.Text = "Buy Seeds Only: OFF"
Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.TextSize, Btn.Font = 15, Enum.Font.SourceSansBold
Btn.Active = true
Btn.Draggable = true
Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 10)

local autoActive = false
Btn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    if autoActive then
        Btn.Text = "Buy Seeds Only: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        Btn.Text = "Buy Seeds Only: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- ລະບົບກວດຈັບສະເພາະເມັດພັນ ຕັດປຸ໋ຍແລະຮ້ານຄ້າອອກທັງໝົດ
task.spawn(function()
    while task.wait(0.15) do
        if autoActive then
            pcall(function()
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        local part = v.Parent
                        if part and part:IsA("BasePart") then
                            local isSeedOnly = false
                            local fullName = v:GetFullName():lower()
                            
                            -- ຕ້ອງບໍ່ແມ່ນ Shop, GUI, Fertilizer ຫຼື ປຸ໋ຍ
                            if not fullName:find("shop") and not fullName:find("gui") and not fullName:find("fertilizer") and not fullName:find("poy") then
                                -- ກວດສອບປ້າຍຊື່ໃນ Part ວ່າມີคำວ່າ Seed ຫຼຶ ເມັດພັນ ແທ້
                                for _, desc in ipairs(part:GetDescendants()) do
                                    if desc:IsA("TextLabel") then
                                        local txt = desc.Text:lower()
                                        if txt:find("seed") or txt:find("ເມັດ") or txt:find("ສຳພັນ") then
                                            isSeedOnly = true
                                            break
                                        end
                                    end
                                end
                                
                                -- ຖ້າກວດພົບว่าเป็นເມັດພັນເທິງສາຍພານແທ້ ຈຶ່ງກົດຊື້
                                if isSeedOnly then
                                    v.MaxActivationDistance = 999999
                                    v.RequiresLineOfSight = false
                                    fireproximityprompt(v)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
