while task.wait(0.5) do
    if autoBuyActive then
        pcall(function()
            -- ວິທີທີ່ 1: ຖ້າຊື້ຜ່ານ RemoteEvent
            -- buyRemote:FireServer("SeedName") -- ใส่ชื่อเมล็ดที่ต้องการซื้อ
            
            -- ວິທີທີ່ 2: ຖ້າຕ້ອງเดินไปกด ProximityPrompt 
            for _, v in ipairs(workspace:GetDescendants()) do
