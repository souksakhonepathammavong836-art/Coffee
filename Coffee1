-- [[ GREEDY GROWERS - SIMPLE PLAYERGUI FIX ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("SimpleAutoBuy") then
    PlayerGui.SimpleAutoBuy:Destroy()
end

local SG = Instance.new("ScreenGui")
SG.Name = "SimpleAutoBuy"
SG.Parent = PlayerGui
SG.ResetOnSpawn = false

local Btn = Instance.new("TextButton", SG)
Btn.Size = UDim2.new(0, 180, 0, 50)
Btn.Position = UDim2.new(0.5, -90, 0.2, 0)
Btn.Text = "Auto Buy: OFF"
Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.TextSize, Btn.Font = 16, Enum.Font.SourceSansBold
Btn.Active = true
Btn.Draggable = true
Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 10)

local autoActive = false
Btn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    if autoActive then
        Btn.Text = "Auto Buy: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        Btn.Text = "Auto Buy: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- ລະບົບຊື້ອັດຕະໂນມັດ
task.spawn(function()
    while task.wait(0.1) do
        if autoActive then
            pcall(function()
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        local parentPart = v.Parent
                        if parentPart and parentPart:IsA("BasePart") then
                            v.MaxActivationDistance = 999999
                            v.RequiresLineOfSight = false
                            fireproximityprompt(v)
                        end
                    end
                end
            end)
        end
    end
end)
