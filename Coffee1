-- ຕາຕະລາງເກັບສະຖານະ (ເພີ່ມ keywords ສຳຮອງ)
local selectedRarities = {
    ["Free"] = false,
    ["Normal"] = false,
    ["Rare"] = false,
    ["Epic"] = false,
    ["Legendary"] = false,
    ["Secret"] = false,
    ["Sacred"] = false,
    ["Heavenly"] = false
}

local function createCheckbox(name, posY, rarityKey)
    local btn = Instance.new("TextButton", Frame)
    btn.Name = rarityKey
    btn.Size = UDim2.new(0.9, 0, 0, 32)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.Text = "❌ " .. name .. " [OFF]"
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize, btn.Font = 12, Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        selectedRarities[rarityKey] = not selectedRarities[rarityKey]
        if selectedRarities[rarityKey] then
            btn.Text = "✅ " .. name .. " [ON]"
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
        else
            btn.Text = "❌ " .. name .. " [OFF]"
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        end
    end)
    return btn
end

createCheckbox("Free (ຟຣີ)", 45, "Free")
