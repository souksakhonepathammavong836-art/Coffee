local function createButton(name, posY, callback)
    local btn = Instance.new("TextButton", Container)
    btn.Size = UDim2.new(0, 250, 0, 35)
    btn.Position = UDim2.new(0, 10, 0, posY)
    btn.Text = name
    btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize, btn.Font = 12, Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(callback)
end

-- 1. Anti-Stun & God Mode (ປ້ອງກັນສະຕັ້ນ ແລະ ບໍ່ຕາຍ)
local antiStunActive = false
createButton("🛡️ Anti-Stun & God Mode: OFF", 10, function()
    antiStunActive = not antiStunActive
    if antiStunActive then
        script.Parent = nil -- ປ່ຽນສະຖານະ
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if antiStunActive and LP.Character then
            pcall(function()
                local hum = LP.Character:FindFirstChild("Humanoid")
                if hum then
                    hum.Health = hum.MaxHealth
                    -- ລຶບສະຖານະສະຕັ້ນ ຫຼື เอฟเฟกต์ล้ม (ถ้ามีในระบบเกม)
                    for _, v in ipairs(LP.Character:GetChildren()) do
                        if v:IsA("StringValue") and (v.Name:lower():find("stun") or v.Name:lower():find("ragdoll")) then
                            v:Destroy()
                        end
                    end
                end
            end)
        end
    end
end)

-- 2. Auto Teleport to Eggs (ວາບໄປເກັບໄຂ່ອັດຕະໂນມັດ)
local autoFarmEgg = false
createButton("🥚 Auto Teleport to Eggs: OFF", 55, function()
    autoFarmEgg = not autoFarmEgg
end)

task.spawn(function()
    while task.wait(1) do
        if autoFarmEgg and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if autoFarmEgg and (obj.Name:lower():find("egg") or obj.Name:lower():find("trex")) and obj:IsA("BasePart") then
                        LP.Character.HumanoidRootPart.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
                        task.wait(1.5) -- ຢຸດຖ້າປະມານ 1.5 ວິນາທີໃຫ້ລະບົບເກັບໄຂ່ทำงาน
                    end
                end
            end)
        end
    end
end)

