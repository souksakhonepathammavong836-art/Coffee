-- [[ COFFEE HUB LOADER ]] --
local CoffeeHub_SAE = "ใส่ลิ้งค์ Raw ของ GitHub เกมที่ 1 ตรงนี้"
local CoffeeHub_SAB = "ใส่ลิ้งค์ Raw ของ GitHub เกมที่ 2 ตรงนี้"

local byGameId = {
    [10563114921] = CoffeeHub_SAE,
    [7709344486] = CoffeeHub_SAB,
}

local byPlaceId = {
    [107778070777162] = CoffeeHub_SAE,
    [109983668079237] = CoffeeHub_SAB,
}

local gameId = game.GameId
while gameId == 0 and game.PlaceId == 0 do
    task.wait()
    gameId = game.GameId
end

local url = byGameId[gameId] or byPlaceId[game.PlaceId]
if not url then
    print("☕ Coffee Hub: ไม่มีสคริปต์สำหรับเกมนี้!")
    return
end

print("☕ Coffee Hub: กำลังโหลดสคริปต์...")
for _ = 1, 3 do
    local ok, source = pcall(game.HttpGet, game, url)
    if ok and type(source) == "string" and source ~= "" then
        local chunk, err = loadstring(source)
        if chunk then
            print("☕ Coffee Hub: เปิดใช้งานสำเร็จ!")
            chunk()
        else
            print("☕ Coffee Hub Loadstring Error:", err)
        end
        return
    end
    task.wait(0.5)
end

print("☕ Coffee Hub: โหลดสคริปต์ไม่สำเร็จ (โปรดตรวจสอบลิงก์อีกครั้ง)")
