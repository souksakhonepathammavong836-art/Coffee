-- Smooth Toggle Animation Handler
local isOpen = true
local function toggleWindow(open)
	isOpen = open
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	
	if isOpen then
		openBtn.Visible = false
		window.Visible = true
		window.Size = UDim2.fromOffset(0, 0)
		TweenService:Create(window, tweenInfo, {Size = UDim2.fromOffset(WIN_W, WIN_H)}):Play()
	else
		local tween = TweenService:Create(window, tweenInfo, {Size = UDim2.fromOffset(0, 0)})
		tween:Play()
		tween.Completed:Connect(function()
			if not isOpen then
				window.Visible = false
				openBtn.Visible = true
			end
		end)
	end
end

closeBtn.Activated:Connect(function() toggleWindow(false) end)
openBtn.Activated:Connect(function() toggleWindow(true) end)

-- Camera Zoom Logic (Client-side)
local currentZoom = 12
local function updateZoom(delta)
	currentZoom = math.clamp(currentZoom + delta, 5, 50)
	player.CameraMinZoomDistance = currentZoom
	player.CameraMaxZoomDistance = currentZoom
	statusLabel.Text = "Zoom Distance: " .. currentZoom
end

zoomIn.Activated:Connect(function() updateZoom(-5) end)
zoomOut.Activated:Connect(function() updateZoom(5) end)
