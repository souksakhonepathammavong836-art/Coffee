	if flying and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character:FindFirstChild("Humanoid") then
		local hrp = LP.Character.HumanoidRootPart
		local hum = LP.Character.Humanoid
		hrp.AssemblyLinearVelocity = Vector3.new(0, 1, 0)
		local moveDir = hum.MoveDirection
		local speedMultiplier = currentFlySpeed / 50
		local upward = Vector3.new(0, verticalDir * speedMultiplier, 0)
		if moveDir.Magnitude > 0 then
			local flatLook = cam.CFrame.LookVector * Vector3.new(1, 0, 1)
			if flatLook.Magnitude > 0 then
				hrp.CFrame = hrp.CFrame + flatLook.Unit * moveDir.Magnitude * speedMultiplier + upward
			end
		elseif verticalDir ~= 0 then
			hrp.CFrame = hrp.CFrame + upward
		end
	end
end)

