	if not activeSlider then return end
	local mouseX = UIS:GetMouseLocation().X
	if activeSlider == "walk" then
		local relX = updateSliderFromX(SliderBg, mouseX)
		currentWalkSpeed = math.floor(1 + relX * (99999 - 1))
		SliderFill.Size = UDim2.new(relX, 0, 1, 0)
		SliderText.Text = "Walk Speed: " .. currentWalkSpeed
