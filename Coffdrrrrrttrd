local function makeButton(text, yPos, height, bgColor, textSize)
	local btn = Instance.new("TextButton", ContentContainer)
	btn.Size = UDim2.new(0, 210, 0, height or 30)
	btn.Position = UDim2.new(0, 15, 0, yPos)
	btn.Text = text
	btn.BackgroundColor3 = bgColor or Color3.fromRGB(100, 100, 100)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = textSize or 11
	btn.Font = Enum.Font.SourceSansBold
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	return btn
end

local function makeSlider(yPos, labelText, fillColor, initialRatio)
	local bg = Instance.new("Frame", ContentContainer)
	bg.Size = UDim2.new(0, 210, 0, 26)
	bg.Position = UDim2.new(0, 15, 0, yPos)
	bg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)

	local fill = Instance.new("Frame", bg)
	fill.Size = UDim2.new(initialRatio or 0, 0, 1, 0)
	fill.BackgroundColor3 = fillColor
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)

	local txt = Instance.new("TextLabel", bg)
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.Text = labelText
	txt.TextColor3 = Color3.fromRGB(255, 255, 255)
	txt.TextSize = 11
	txt.Font = Enum.Font.SourceSansBold
	txt.BackgroundTransparency = 1

	local trigger = Instance.new("TextButton", bg)
	trigger.Size = UDim2.new(1, 0, 1, 0)
	trigger.Text = ""
	trigger.BackgroundTransparency = 1

	return bg, fill, txt, trigger
end

