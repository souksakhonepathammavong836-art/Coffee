-- Dungeon Mob Helpers
local function isPlayerModel(model)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and (model == plr.Character or model:IsDescendantOf(plr.Character)) then
			return true
		end
	end
	return false
end

local function getNearestMonster(maxDist)
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return nil, nil end

	local bestHum, bestRoot = nil, nil
	local bestDist = maxDist or math.huge

	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("Humanoid") and desc.Health > 0 then
			local model = desc.Parent
			if model and model ~= char and not isPlayerModel(model) then
				local mobRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
				if mobRoot then
					local d = (mobRoot.Position - root.Position).Magnitude
					if d < bestDist then
						bestDist = d
						bestHum = desc
						bestRoot = mobRoot
					end
				end
			end
		end
	end

	return bestHum, bestRoot
end

local function triggerAttack()
	local char = LP.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then
		pcall(function() tool:Activate() end)
	end
end

