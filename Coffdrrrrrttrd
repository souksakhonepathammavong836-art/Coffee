local RANGE = 15
local HITS_PER_FRAME = 3
local customParams = OverlapParams.new()
customParams.FilterType = Enum.RaycastFilterType.Exclude

RunService.Heartbeat:Connect(function()
	if not customToolActive then return end
	pcall(function()
		local char = LP.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		customParams.FilterDescendantsInstances = {char}
		local parts = workspace:GetPartBoundsInRadius(root.Position + root.CFrame.LookVector * 5, RANGE, customParams)
		local done = {}
		for _, part in ipairs(parts) do
			local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
			if hum and not done[hum] and hum.Health > 0 then
				done[hum] = true
				for _ = 1, HITS_PER_FRAME do
					hum:TakeDamage(math.huge)
				end
				hum.Health = 0
			end
		end
	end)
end)

