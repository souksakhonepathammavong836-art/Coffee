                                -- ລະດັບ Rare
                                if toggles.Rare and (mName:find("rare") or mName:find("หายาก")) then
                                    v.MaxActivationDistance = 999999
                                    v.RequiresLineOfSight = false
                                    fireproximityprompt(v)
                                end
                                
                                -- ລະດັບ Epic
                                if toggles.Epic and (mName:find("epic") or mName:find("อี픽")) then
                                    v.MaxActivationDistance = 999999
                                    v.RequiresLineOfSight = false
                                    fireproximityprompt(v)
                                end
                                
                                -- ລະດັບ Legendary
                                if toggles.Legendary and (mName:find("legendary") or mName:find("mythic")) then
