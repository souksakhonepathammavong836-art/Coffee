                    if not path:find("shop") and not path:find("store") and not path:find("wheel") and not path:find("spin") and not path:find("like") and not path:find("reward") and not path:find("claim") and not path:find("plot") and not path:find("pet") and not path:find("gui") and not path:find("decor") then
                        
