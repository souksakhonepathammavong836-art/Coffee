local SG = Instance.new("ScreenGui")
SG.Name = "TierSeedHub"
SG.Parent = LP:WaitForChild("PlayerGui")
SG.ResetOnSpawn = false

-- ຫຼັກ GUI Frame
local Frame = Instance.new("Frame", SG)
Frame.Size = UDim2.new(0, 220, 0, 240)
Frame.Position = UDim2.new(0.5, -110, 0.2, 0)
Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true
Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)

-- Title
local Title = Instance.new("TextLabel", Frame)
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "Select Seed Tier to Buy"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize, Title.Font = 14, Enum.Font.SourceSansBold
Title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Instance.new("UICorner", Title).CornerRadius = UDim.new(0, 10)

-- Table ເກັບສະຖານະການເປີດ-ປິດແຕ່ລະລະດັບ
local toggles = {
    Normal = false,
    Rare = false,
    Epic = false,
    Legendary = false
}

local function createTierButton(name, posY, tierKey)
    local btn = Instance.new("TextButton", Frame)
    btn.Size = UDim2.new(0, 200, 0, 35)
    btn.Position = UDim2.new(0.5, -100, 0, posY)
    btn.Text = name .. ": OFF"
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize, btn.Font = 13, Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        toggles[tierKey] = not toggles[tierKey]
        if toggles[tierKey] then
            btn.Text = name .. ": ON"
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        else
            btn.Text = name .. ": OFF"
            btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        end
    end)
end

createTierButton("Normal Seeds", 45, "Normal")
createTierButton("Rare Seeds", 85, "Rare")
createTierButton("Epic Seeds", 125, "Epic")
createTierButton("Legendary Seeds", 165, "Legendary")

