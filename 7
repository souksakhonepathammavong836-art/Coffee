-- Logic: Fast Global Chop
local fastChopActive = false
FastChopBtn.MouseButton1Click:Connect(function()
    fastChopActive = not fastChopActive
    if fastChopActive then
        FastChopBtn.Text = "⚡ Fast Global Chop: ON"
        FastChopBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        FastChopBtn.Text = "⚡ Fast Global Chop: OFF"
        FastChopBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if fastChopActive then
            pcall(function()
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and (obj.Name:find("Tree") or obj.Name:find("Wood") or obj.Name:lower():find("pine") or obj.Name:lower():find("oak")) then
                        for _, part in ipairs(obj:GetDescendants()) do
                            if part:IsA("BasePart") and (part.Name:find("WoodSection") or part.Name:find("Part") or part.Name:find(" tronco")) then
                                -- ຈຳລອງການທຳລາຍ ຫຼື ສັ່ງ Fire Remote ໄປຫາທຸກສ່ວນຂອງຕົ້ນໄມ້ໃນແມບພ້ອມກັນ
                                local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool") or LP.Backpack and LP.Backpack:FindFirstChildOfClass("Tool")
                                if tool then
                                    for _, remote in ipairs(tool:GetDescendants()) do
                                        if remote:IsA("RemoteEvent") then
                                            remote:FireServer(part)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Logic: Bring All Woods
BringAllBtn.MouseButton1Click:Connect(function()
    pcall(function()
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            local myPos = LP.Character.HumanoidRootPart.Position
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and (obj.Name:find("Wood") or obj.Name:find("Log")) then
                    for _, part in ipairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CFrame = CFrame.new(myPos + Vector3.new(math.random(-5,5), 3, math.random(-5,5)))
                        end
                    end
                end
            end
        end
    end)
end)

-- Logic: Tree ESP
local treeEspActive = false
local treeFolder = Instance.new("Folder", SG)
treeFolder.Name = "TreeESPFolder"

TreeEspBtn.MouseButton1Click:Connect(function()
    treeEspActive = not treeEspActive
    if treeEspActive then
        TreeEspBtn.Text = "👀 Tree ESP: ON"
        TreeEspBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        TreeEspBtn.Text = "👀 Tree ESP: OFF"
        TreeEspBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        treeFolder:ClearAllChildren()
    end
end)

task.spawn(function()
    while task.wait(1) do
        if treeEspActive then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and (obj.Name:find("Tree") or obj.Name:find("Wood")) then
                    local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if targetPart and not targetPart:FindFirstChild("TreeHighlight") then
                        local hl = Instance.new("Highlight", treeFolder)
                        hl.Name = "TreeHighlight"
                        hl.Adornee = obj
                        hl.FillColor = Color3.fromRGB(255, 170, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.5
                    end
                end
            end
        else
            treeFolder:ClearAllChildren()
        end
    end
end)

