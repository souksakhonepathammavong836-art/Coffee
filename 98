-- ==================== ລະບົບການເຮັດວຽກຂອງຟັງຊັ່ນໂກງ ====================

-- 1. God Damage & Fast Attack (ຕີມອນຕາຍທັນທີ 0.01s ໄລຍະກວ້າງ)
local isDmgActive = false
dmgBtn.MouseButton1Click:Connect(function()
    isDmgActive = not isDmgActive
    if isDmgActive then
        dmgBtn.Text = "1. GOD DAMAGE: ON"
        dmgBtn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        dmgBtn.Text = "1. GOD DAMAGE: OFF"
        dmgBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.01) -- ຄວາມໄວສູງສຸດ 100 ຮິດ/ວິນາທີ
        if isDmgActive then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPos = char.HumanoidRootPart.Position
                    
                    -- ພະຍາຍາມເພີ່ມຄ່າ Power / Leaderstats ຖ້າມີ (ເພື່ອດັນດາເມດຝັ່ງ Client)
                    local leaderstats = player:FindFirstChild("leaderstats")
                    if leaderstats then
                        local power = leaderstats:FindFirstChild("Power") or leaderstats:FindFirstChild("Damage")
                        if power then
                            power.Value = 999999999
                        end
                    end

                    -- ກວາດລ້າງມອນສະເຕີໃນ Map ໃຫ້ເລືອດເປັນ 0 ທັນທີ
                    for _, obj in pairs(workspace:GetChildren()) do
                        if obj:FindFirstChild("Humanoid") and obj ~= char then
                            local enemyRoot = obj:FindFirstChild("HumanoidRootPart")
                            if enemyRoot then
                                if (rootPos - enemyRoot.Position).Magnitude <= 180 then
                                    obj.Humanoid.Health = 0
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 2. Auto-Collect
local isCollectActive = false
collectBtn.MouseButton1Click:Connect(function()
    isCollectActive = not isCollectActive
    if isCollectActive then
        collectBtn.Text = "2. AUTO-COLLECT: ON"
        collectBtn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        collectBtn.Text = "2. AUTO-COLLECT: OFF"
        collectBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if isCollectActive then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPos = char.HumanoidRootPart.Position
                    for _, obj in pairs(workspace:GetChildren()) do
                        if obj:IsA("BasePart") and (obj.Name == "Coin" or obj.Name == "Gem" or obj.Name == "Drop") then
                            if (obj.Position - rootPos).Magnitude <= 80 then
                                obj.Position = rootPos
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 3. Speed Boost
local isSpeedActive = false
speedBtn.MouseButton1Click:Connect(function()
    isSpeedActive = not isSpeedActive
    if isSpeedActive then
        speedBtn.Text = "3. SPEED BOOST: ON"
        speedBtn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        speedBtn.Text = "3. SPEED BOOST: OFF"
        speedBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") then
                if isSpeedActive then
                    char.Humanoid.WalkSpeed = 50
                else
                    char.Humanoid.WalkSpeed = 16
                end
            end
        end)
    end
end)

-- 4. Teleport to Sell Area
tpBtn.MouseButton1Click:Connect(function()
    pcall(function()
        local sellPart = workspace:FindFirstChild("SellPart")
        if sellPart and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = sellPart.CFrame + Vector3.new(0, 3, 0)
        end
    end)
end)

